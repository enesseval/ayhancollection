R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Yalnız R2 için: bucket'ın public alan adı, ör. https://cdn.ayseayhancollection.com
NEXT_PUBLIC_MEDIA_BASE_URL=

# ── İsteğe bağlı ─────────────────────────────────────────
