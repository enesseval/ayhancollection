# ── Zorunlu ──────────────────────────────────────────────
# Sitenin herkese açık adresi (Vercel'de: https://<proje>.vercel.app veya kendi alan adınız)
NEXT_PUBLIC_SITE_URL=https://ayseayhancollection.vercel.app
# En az 32 karakter rastgele değer: openssl rand -hex 32
SESSION_SECRET=

# ── Demo mod (Supabase bağlanana kadar) ──────────────────
DEMO_ADMIN_EMAIL=admin@ayseayhan.demo
# Boş bırakılırsa varsayılan demo şifresi kullanılır: AyseAyhan-Demo-2026
DEMO_ADMIN_PASSWORD=

# ── Supabase (girildiğinde demo veri yerine gerçek veritabanı kullanılır) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── iyzico (girildiğinde demo ödeme yerine iyzico Checkout Form) ──
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
# Test: https://sandbox-api.iyzipay.com  ·  Canlı: https://api.iyzipay.com
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# ── Cloudflare R2 (isteğe bağlı; boş bırakılırsa görseller Supabase Storage'da tutulur) ──
